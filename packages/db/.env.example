# Used by the Prisma CLI (migrate/studio/seed) when run from this package.
# Keep this in sync with apps/api/.env's DATABASE_URL — they must point to the same database.
DATABASE_URL="mysql://root:password@localhost:3306/vip_mobiles"

# Required by scripts/seed.ts to create the real (non-demo) Super Admin account.
SUPER_ADMIN_NAME="Store Owner"
SUPER_ADMIN_EMAIL="owner@vipmobiles.com"
SUPER_ADMIN_PASSWORD="ChangeThisPassword123!"

# Set to "true" to also insert realistic demo catalog/branch/sales data (flagged isDemo=true
# so it can be wiped later with `npm run db:reset`). Leave "false" for a clean production seed.
SEED_DEMO_DATA=true
