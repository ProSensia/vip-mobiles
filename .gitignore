# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
#
# backend/dist is intentionally NOT ignored — it's committed on purpose so
# the server can `git pull` an already-built backend and skip `npm run
# build` entirely (tsc output has no absolute paths baked in, so it's safe
# to build anywhere and run anywhere).
#
# frontend/.next IS still ignored — Next's build output bakes in absolute
# filesystem paths (outputFileTracingRoot, manifests, etc.), so a copy built
# on one machine breaks when deployed to another. Build it fresh with
# `npm run build` on whichever machine will actually run it.
build/
out/
.next/

# Env files — deliberately tracked (not ignored) for the three real deploy
# configs so `git pull` on the server brings working secrets with it, no
# manual cPanel/terminal step needed. Still ignore any *other* .env variant
# (.env.local, .env.test, etc.) that isn't one of these three.
.env*
!.env.example
!backend/.env
!packages/db/.env
!frontend/.env.production

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Prisma
packages/db/generated/

# Uploads (local dev media storage)
backend/uploads/
backend/uploads-tmp/

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# Testing
coverage/

# Misc
*.tsbuildinfo
.turbo/
