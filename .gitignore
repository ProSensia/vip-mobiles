# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.next/
out/

# Env files — anything starting with .env is a real-secrets file (.env,
# .env.local, .env.production, .env.development, etc.) except .env.example
.env*
!.env.example

# Same secrets, temporarily renamed without a leading dot so they show up in
# file managers that hide dotfiles by default (e.g. cPanel File Manager) —
# delete these locally once uploaded.
env-upload-then-rename-to-*

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Prisma
packages/db/generated/

# Uploads (local dev media storage)
backend/uploads/
backend/uploads-tmp/

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# Testing
coverage/

# Misc
*.tsbuildinfo
.turbo/
