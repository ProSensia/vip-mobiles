# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
#
# backend/dist is intentionally NOT ignored — it's committed on purpose so
# the server can `git pull` an already-built backend and skip `npm run
# build` entirely (tsc output has no absolute paths baked in, so it's safe
# to build anywhere and run anywhere).
#
# frontend/.next IS still ignored — Next's build output bakes in absolute
# filesystem paths (outputFileTracingRoot, manifests, etc.), so a copy built
# on one machine breaks when deployed to another. Build it fresh with
# `npm run build` on whichever machine will actually run it.
build/
out/
.next/

# Env files — anything starting with .env is a real-secrets file (.env,
# .env.local, .env.production, .env.development, etc.) except .env.example
.env*
!.env.example

# Same secrets, temporarily renamed without a leading dot so they show up in
# file managers that hide dotfiles by default (e.g. cPanel File Manager) —
# delete these locally once uploaded.
env-upload-then-rename-to-*

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Prisma
packages/db/generated/

# Uploads (local dev media storage)
backend/uploads/
backend/uploads-tmp/

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# Testing
coverage/

# Misc
*.tsbuildinfo
.turbo/
