PassengerAppRoot "/home/prosdfwo/vipmobile.prosensia.pk/frontend"
PassengerBaseURI "/"
PassengerNodejs "/home/prosdfwo/nodevenv/vipmobile.prosensia.pk/frontend/20/bin/node"
PassengerAppType node
PassengerStartupFile server.js

# Shared hosting kills idle app processes after a period of inactivity; the
# next request then pays a multi-second cold-start penalty (spawn Node,
# re-require every module) — which shows up as "sometimes fast, sometimes
# the page just hangs." Keep at least one process warm at all times.
PassengerMinInstances 1

# The domain docroot is the whole repo checkout, so Apache/LiteSpeed will
# happily serve these folders/files as plain static content — bypassing
# Passenger entirely — for anyone who requests them directly. backend/ and
# packages/db/ contain real .env files with production DB/JWT secrets, so
# this isn't just a routing nuisance, it's a live credential leak until
# blocked explicitly.
Options -Indexes

<FilesMatch "(^\.env|\.env\.|docker-compose\.yml|package(-lock)?\.json)$">
  Require all denied
</FilesMatch>

RewriteEngine On

# Serve uploaded product/media files directly as static files instead of
# proxying every image through the Next.js/Node process. This is what was
# actually causing broken/black images: Next's rewrite for /uploads/* was
# pointed at the public domain, which isn't covered by the /api BaseURI, so
# the webserver routed it straight back to the frontend app — a
# self-referential proxy loop, occasionally manifesting as a reset
# connection rather than a clean failure. Resolving it to a real file here
# means Apache/LiteSpeed serves it directly, no Node process involved at
# all — faster, and structurally can't loop. [END] fully stops rewrite
# processing so this resolved path isn't re-evaluated against the block
# rule below.
RewriteRule ^uploads/(.*)$ backend/uploads/$1 [END]

RewriteRule ^(backend(?!/uploads/)|packages|docs|Logo|scripts)(/|$) - [F,L]
