# Server
NODE_ENV=development
PORT=4000
WEB_APP_URL=http://localhost:3000

# MySQL connection (also used by packages/db for Prisma migrations)
DATABASE_URL="mysql://root:password@localhost:3306/vip_mobiles"

# Auth — generate strong random values for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me-to-a-long-random-string-min-16-chars"
JWT_REFRESH_SECRET="change-me-to-a-different-long-random-string"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Cookies (leave blank for localhost; set to your domain in production, e.g. ".vipmobiles.com")
COOKIE_DOMAIN=

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15

# Rate limiting
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
